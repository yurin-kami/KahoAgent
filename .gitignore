# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/
/build/

# Test
*.test
*.out
coverage.html

# Dependency
/vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Config (secrets)
config.toml
# ⚠️ 通配而非只列 config.toml：PDF 语料引入了 config.pdf.toml，
# 后续再加隔离配置时很容易忘记补 .gitignore —— 而漏一次就是
# API Key 进仓库。用模式匹配把「新增配置文件」这个失误堵死，
# .example 结尾的模板不含密钥，显式放行。
config*.toml
!config*.example.toml
!config*.toml.example
.env

# OS
.DS_Store
Thumbs.db

# Windows reserved device names.
# git on Windows can surface these as phantom untracked entries even when
# no such file exists on disk (a stray shell redirect is enough to trigger it).
NUL
CON
PRN
AUX

# Temp
/tmp/

# PDF 离线预处理（scripts/pdf/）
# venv 含 MinerU 模型，数 GB；中间产物与生成的测试数据都可重新生成，不入库。
scripts/pdf/.venv/
scripts/pdf/out/
scripts/pdf/testdata/
scripts/pdf/converted/
__pycache__/

# 个人材料（面试问答稿）。本地保留、不入公开仓库 ——
# 已用 git filter-repo 从全部历史中清除，这一行防止再次误加。
docs/resume-material.md

# 本机构建缓存（沙箱把默认 GOCACHE/GOMODCACHE 设成了只读路径，
# 只能指到仓库内；这些目录纯属本地产物，不应入库）
/.gocache/
/.gomodcache/
# 简历构建产物（本地资料，见 docs/upgrade-plan.md）
/.resume-build/

# Electron 桌面端依赖（npm install 生成，不入库）
/desktop/node_modules/

# 本地 embedding 服务
/scripts/local-embed/.venv/
/scripts/local-embed/models/
